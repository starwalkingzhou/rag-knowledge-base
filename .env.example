# ==== 应用配置 ====
APP_NAME=rag-knowledge-base
LOG_LEVEL=INFO

# ==== PostgreSQL ====
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database_name
POSTGRES_PORT=5432

# 后端连接串:注意使用 asyncpg driver
DATABASE_URL=postgresql+asyncpg://your_username:your_password@localhost:5432/your_database_name

# ==== 腾讯云 COS ====
COS_SECRET_ID=your_secret_id
COS_SECRET_KEY=your_secret_key
COS_REGION=ap-guangzhou
COS_BUCKET=your_bucket_name

# ==== CORS (逗号分隔,前端开发默认地址) ====
CORS_ORIGINS=http://localhost:5173

# ==== Embedding (DashScope OpenAI 兼容协议) ====
# api key: https://bailian.console.aliyun.com/ -> API-KEY
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ==== 文档上传与切分 ====
UPLOAD_MAX_SIZE_MB=50
CHUNK_SIZE=600
CHUNK_OVERLAP=60

# ==== Chat LLM ====
CHAT_API_KEY=your_chat_api_key
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.6
CHAT_HISTORY_WINDOW=5

# ==== Query 优化 ====
# 关掉后强制走 original 路径,便于对比有/无路由的效果
QUERY_ROUTE_ENABLED=true
# Multi-Query 策略生成的子查询数量
MULTI_QUERY_COUNT=3

# ==== 认证 ====
# JWT 签名密钥；生产环境务必改成足够长的随机串
# 生成示例：openssl rand -hex 32
JWT_SECRET=changeme-please-use-a-strong-random-secret
JWT_ALGORITHM=HS256
# token 过期分钟数，默认 24 小时
JWT_EXPIRE_MINUTES=1440

# 首次启动种子管理员：库内无用户时自动创建（已有用户时跳过）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_DISPLAY_NAME=管理员

# ==== Agentic RAG ====
# false 时整图退化为单轮检索，便于对比开/关 agent 循环
AGENT_LOOP_ENABLED=true
# 最大检索轮次（含首轮）
AGENT_MAX_ROUNDS=3

# ===== Reranker =====
# 关掉后 rerank 节点透传,方便对比有/无精排
RERANK_ENABLED=True
RERANK_MODEL=qwen3-rerank
# DashScope qwen3-rerank 兼容接口(不是 OpenAI 标准)
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# 留空则自动复用 CHAT_API_KEY
RERANK_API_KEY=
# Top1 relevance_score < 此值视为上下文不足,触发拒答;分数 ∈ [0, 1]
RERANK_MIN_SCORE=0.3
RERANK_TIMEOUT=8.0

# ===== 答案校验 =====
# 关掉后跳过 verify_answer,方便对比有/无引用支撑校验
VERIFY_ANSWER_ENABLED=True

# ===== LangSmith 可观测性 =====
# 关掉后 trace 整链路降级
LANGSMITH_TRACING=False
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-knowledge-base
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# 配置后前端会展示「在 LangSmith 中查看」跳转链接，未配置则只显示复制按钮
# 格式：https://smith.langchain.com/o/{org_id}/projects/p/{project_name}
LANGSMITH_RUN_URL_PREFIX=
